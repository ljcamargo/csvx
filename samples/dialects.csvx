---
version: "0.2.0"
dialect:
  csv:
    delimiter: ","
    quote: "'"
  csvx:
    formula_dialect: ods
meta:
  note: >
    ' wrapper -> inclusions use " (quote alternation, SPEC §8.1). " inside a
    '...' field is literal content (SPEC §8.2).
---
city,country,note
'Madrid, Spain',ES,'{{"rating": 5}}'
'San José, Costa Rica',CR,'text with "double" quotes'
